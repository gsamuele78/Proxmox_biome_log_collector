# Secrets / local overrides — never commit real values
.env
.env.*
!.env.example
*.secret
*.key
*.pem
!config/traefik/dynamic/*.pem.example

# Runtime data volumes if bind-mounted locally for testing
.omo
.omo/
.omo/*
data/
volumes/
prometheus-data/
grafana-data/
loki-data/
alertmanager-data/
pegaprox-data/
pdm-config/
pdm-data/

# Fetched (not hand-authored) Grafana dashboards — pulled fresh by scripts/fetch-community-dashboards.sh
config/grafana/provisioning/dashboards/files/*.json

# Generated Prometheus file_sd targets (real infra IPs) — only *.json.example is tracked
config/prometheus/targets/*.json
!config/prometheus/targets/*.json.example

# Rendered Alertmanager config (real SMTP credentials) — only the .tmpl is tracked
config/alertmanager/alertmanager.yml

# Generated secrets dir used by scripts/generate-secrets.sh, if any file-based secrets are added
secrets/

# Reports generated by cv4pve-diag / PegaProx
reports/
*.report.html

# Node / tooling artifacts
*.log
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Terraform-style local state, in case IaC is added later
*.tfstate
*.tfstate.backup
.terraform/

# Claude Code local settings (already present, keep local-only permission overrides out of history)
.claude/settings.local.json
tests/lab/.vagrant/
tests/lab/artifacts/

# Local agent/tooling state (Serena, oh-my-opencode) — never commit
.serena/
.omo/
