# Lab-only .env for tests/lab (non-secret, throwaway values). Copied to
# /opt/proxmox-biome/.env by tests/e2e/t0-deploy.sh; the real PVE token secret
# is injected there by tests/lab/run.sh at tier >= 1.
BASE_DOMAIN=biome.lab.test
ACME_EMAIL=lab@biome.lab.test
TRAEFIK_BASIC_AUTH_USERS=admin:$$2y$$05$$CHANGEME_GENERATE_WITH_HTPASSWD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_RUN_scripts_generate-secrets.sh
PVE_API_TOKEN_ID=monitoring@pve!observability
PVE_API_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# IPs, not names: containers use Docker's DNS, not the VM's /etc/hosts.
CV4PVE_DIAG_HOSTS=10.77.10.11
CV4PVE_EXPORTER_HOSTS=10.77.10.11
LOKI_BIND_ADDR=10.77.10.10
# Mailpit sink on the monitoring VM (provision/monitoring.sh); plaintext, hence no TLS.
ALERTMANAGER_SMTP_SMARTHOST=10.77.10.10:1025
ALERTMANAGER_SMTP_FROM=alerts@biome.lab.test
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_RECEIVER_EMAIL=oncall@biome.lab.test
ALERTMANAGER_SMTP_REQUIRE_TLS=false
ALERTMANAGER_WEBHOOK_URL=
# Tier 3 (idp VM). Harmless below tier 3: oauth2-proxy is profile-gated.
KEYCLOAK_ISSUER_URL=http://keycloak.biome.lab.test:8080/realms/lab
KEYCLOAK_CLIENT_ID=proxmox-monitoring
KEYCLOAK_CLIENT_SECRET=biome-lab-client-secret
OAUTH2_PROXY_COOKIE_SECRET=
PEGAPROX_ADMIN_EMAIL=lab@biome.lab.test
