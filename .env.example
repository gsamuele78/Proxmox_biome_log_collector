# =============================================================================
# Proxmox Biome Observability & Compliance Stack — environment configuration
#
# Copy this file to `.env` (never commit `.env`) and fill in real values, or
# run `scripts/generate-secrets.sh` to auto-generate the secret-type values.
# See docs/deployment-guide.md for the full bootstrap walkthrough.
# =============================================================================

# --- General ---------------------------------------------------------------
TZ=Europe/Rome
# Base domain used for all Traefik host routes: grafana.<BASE_DOMAIN>, pdm.<BASE_DOMAIN>, audit.<BASE_DOMAIN>
BASE_DOMAIN=monitoring.example.internal
# Email used for ACME/Let's Encrypt if you terminate public TLS here; irrelevant if you
# provide your own internal CA certificate instead (see config/traefik/dynamic/tls-options.yml).
ACME_EMAIL=admin@example.com

# --- Phase 1: local-auth bootstrap ------------------------------------------
# htpasswd-format credentials for Traefik's basicAuth middleware, used ONLY until
# Keycloak OIDC (Phase 2, below) is wired up. Generate with:
#   htpasswd -nbB admin 'a-strong-password'
# and paste the resulting "admin:$2y$..." line here (escape every '$' as '$$' for
# docker-compose environment interpolation).
TRAEFIK_BASIC_AUTH_USERS=admin:$$2y$$05$$CHANGEME_GENERATE_WITH_HTPASSWD

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME_RUN_scripts_generate-secrets.sh

# --- Proxmox VE API access ----------------------------------------------------
# Use a dedicated, least-privilege API token (Datacenter -> Permissions -> API Tokens),
# NOT the root password. PVEAuditor covers cv4pve-metrics-exporter and PDM read
# operations; cv4pve-diag additionally needs Datastore.Audit on backup storages to see
# backup content (PVEAuditor alone cannot — see upstream's "Permissions" doc).
# Which PVE hosts each tool talks to is set per tool below (CV4PVE_*_HOSTS).
PVE_API_TOKEN_ID=monitoring@pve!observability
PVE_API_TOKEN_SECRET=CHANGEME_PASTE_TOKEN_SECRET

# --- cv4pve-diag (default NIS2/ISO27001/GDPR/DORA compliance auditor) --------
# Comma-separated; any one node per cluster is enough (cv4pve-diag walks the cluster),
# extra nodes are fallbacks tried in order if the first is down.
# Scheduling is done by the host systemd timer (scripts/systemd/cv4pve-diag.timer,
# OnCalendar=), not by a variable here.
CV4PVE_DIAG_HOSTS=pve-node01.mgmt.example.internal

# --- cv4pve-metrics-exporter (Prometheus-native PVE object metrics) ---------
CV4PVE_EXPORTER_HOSTS=pve-node01.mgmt.example.internal,pve-node02.mgmt.example.internal

# --- Loki log ingest -----------------------------------------------------------
# Host address Loki's push port (3100) is published on, so the PVE nodes' Alloy agents
# can ship logs. Set this to the monitoring VM's MANAGEMENT-LAN IP so the port is never
# bound on a perimeter-facing interface. Default (unset) binds all interfaces.
LOKI_BIND_ADDR=

# --- Alertmanager notifications ----------------------------------------------
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.internal:587
ALERTMANAGER_SMTP_FROM=proxmox-alerts@example.com
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_RECEIVER_EMAIL=soc@example.com
# Optional: webhook (e.g. internal SOC/SIEM ingest, Slack/Teams connector, etc.).
# Setting this alone does nothing — also uncomment the webhook_configs block
# in config/alertmanager/alertmanager.yml.tmpl, then re-run bootstrap.
ALERTMANAGER_WEBHOOK_URL=

# --- Phase 2: Keycloak OIDC (steady-state auth — see docs/keycloak-integration.md) ---
# Leave blank while still on local-auth bootstrap; fill in once your Keycloak realm/client exist.
KEYCLOAK_ISSUER_URL=https://keycloak.example.internal/realms/corp
KEYCLOAK_CLIENT_ID=proxmox-monitoring
KEYCLOAK_CLIENT_SECRET=
# oauth2-proxy cookie secret, generate with:
#   python3 -c 'import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# --- Optional: PegaProx (EXPERIMENTAL/BETA — off by default, see ADR-0005) ---
# Only used when launching with: docker compose -f docker-compose.yml -f docker-compose.pegaprox.yml up -d
PEGAPROX_ADMIN_EMAIL=admin@example.com
