## TEMPLATE — Alertmanager does not support ${VAR} substitution in its own
## config file (unlike docker-compose.yml), so this .tmpl is rendered to the
## real config/alertmanager/alertmanager.yml (gitignored, contains real SMTP
## credentials) by `scripts/bootstrap-monitoring-vm.sh` using `envsubst`,
## sourcing `.env` first — same pattern as the generated
## config/prometheus/targets/*.json files. Never hand-edit the rendered file;
## edit this template and re-run the bootstrap script.

global:
  resolve_timeout: 5m
  smtp_smarthost: "${ALERTMANAGER_SMTP_SMARTHOST}"
  smtp_from: "${ALERTMANAGER_SMTP_FROM}"
  smtp_auth_username: "${ALERTMANAGER_SMTP_USERNAME}"
  smtp_auth_password: "${ALERTMANAGER_SMTP_PASSWORD}"
  # Keep true in production. Set ALERTMANAGER_SMTP_REQUIRE_TLS=false only for a
  # plaintext relay (e.g. the Mailpit sink in tests/lab).
  smtp_require_tls: ${ALERTMANAGER_SMTP_REQUIRE_TLS}

route:
  receiver: default
  group_by: ["alertname", "cluster"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: critical
      repeat_interval: 1h

receivers:
  - name: default
    email_configs:
      - to: "${ALERTMANAGER_RECEIVER_EMAIL}"
        send_resolved: true

  # If you set ALERTMANAGER_WEBHOOK_URL in .env, uncomment the two lines
  # below (envsubst has no conditionals — a webhook_configs block with an
  # empty url fails `amtool check-config`, so it can't ship enabled by
  # default). Re-run `scripts/bootstrap-monitoring-vm.sh` after editing.
  - name: critical
    email_configs:
      - to: "${ALERTMANAGER_RECEIVER_EMAIL}"
        send_resolved: true
    # webhook_configs:
    #   - url: "${ALERTMANAGER_WEBHOOK_URL}"
    #     send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal:
      - alertname
      - instance
